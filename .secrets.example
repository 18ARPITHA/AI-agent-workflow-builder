# Copy to .secrets (gitignored) for `nhost dev`. In the hosted nhost project,
# set these as environment variables in the dashboard instead.

HASURA_ADMIN_SECRET=nhost-admin-secret
HASURA_GRAPHQL_JWT_SECRET={"type":"HS256","key":"replace-with-a-long-random-string-min-32-chars"}
HASURA_WEBHOOK_SECRET=nhost-webhook-secret

ACTIONS_WEBHOOK_SECRET=change-me

# nhost serves each file under functions/ at /v1/functions/<path-without-ext>
# e.g. functions/actions/triggerWorkflowRun.ts -> /v1/functions/actions/triggerWorkflowRun
TRIGGER_WORKFLOW_RUN_HANDLER_URL=http://local.functions.nhost.run/v1/functions/actions/triggerWorkflowRun
APPROVE_STEP_HANDLER_URL=http://local.functions.nhost.run/v1/functions/actions/approveStep
NOTIFY_EVENT_WEBHOOK_URL=http://local.functions.nhost.run/v1/functions/events/notify
DB_EVENT_TRIGGER_WEBHOOK_URL=http://local.functions.nhost.run/v1/functions/events/onIncomingEvent
SCHEDULED_RUNNER_URL=http://local.functions.nhost.run/v1/functions/scheduled/cronRunner
