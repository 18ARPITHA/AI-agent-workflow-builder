# Injected automatically by nhost in a real deployment — set locally for `nhost dev`.
HASURA_GRAPHQL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/local

# Shared secret checked on every Action/Event Trigger webhook call (set the
# same value in hasura/metadata via ACTIONS_WEBHOOK_SECRET env on the Hasura side).
ACTIONS_WEBHOOK_SECRET=change-me

# LLM provider for llm_call steps. Leave LLM_API_KEY unset (or LLM_STUB=true)
# to run with a disclosed artificial-delay stub instead of a real call.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_STUB=false

# notify step (optional — falls back to console.log stub if unset)
SLACK_WEBHOOK_URL=
EMAIL_API_KEY=
